# Unreal Engine generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Platforms/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaged builds (upload these to itch.io, don't commit them)
Packaged/
Builds/
*.zip

# IDE / build files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Raw source files for imported assets (the .uasset holds the data; keep the source next to it
# so Unreal does not ask to delete the asset, but do not commit it)
JumpCut/Content/Game/Imported/**/*.png
JumpCut/Content/Game/Imported/**/*.jpg
JumpCut/Content/Game/Imported/**/*.fbx
JumpCut/Content/Game/Imported/**/*.Fbx

# Per-PC Claude Code settings
.claude/settings.local.json

# Blender auto-backups, script outputs and caches (rebuilt by running the scripts)
*.blend1
Art/Blender/textures/
Art/Blender/cache/
# Art/Blender/export/ is NOT ignored: makers commit FBX and textures there for the builder to import
# (CLAUDE.md, "Working as a team"). It was ignored until Nov 12, which meant hand-offs never reached the builder.
# Personal reference photos (may show number plates or people)
Art/Reference/

# local image generator output (tools/gen_images.py)
Art/Refs/gen/
